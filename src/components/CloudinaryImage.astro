---
import { Cloudinary } from '@cloudinary/url-gen';
import { fill } from '@cloudinary/url-gen/actions/resize';
import { autoGravity } from '@cloudinary/url-gen/qualifiers/gravity';

interface Props {
  publicId: string;
  fallback: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  priority?: boolean;
}

const {
  publicId,
  fallback,
  alt,
  width,
  height,
  class: className = '',
  priority = false,
} = Astro.props;

const useCloudinary = Boolean(import.meta.env.CLOUDINARY_CLOUD_NAME && publicId);
const cloudinaryUrl = useCloudinary
  ? new Cloudinary({ cloud: { cloudName: import.meta.env.CLOUDINARY_CLOUD_NAME } })
      .image(publicId)
      .format('auto')
      .quality('auto')
      .resize(fill().width(width).height(height).gravity(autoGravity()))
      .toURL()
  : fallback;
---

<img
  src={cloudinaryUrl}
  width={width}
  height={height}
  alt={alt}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
/>
