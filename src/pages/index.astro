---
import CloudinaryImage from '../components/CloudinaryImage.astro';
import '../styles/global.css';
import content from '../data/site.json';

const { seo, links, hero, flavorsSection, flavors, story, meeting, locations, finalCta } = content;
const whatsappUrl = `https://wa.me/${links.whatsapp}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seo.description} />
    <meta name="theme-color" content="#1459d9" />
    <title>{seo.title}</title>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 md:px-8">
      <nav class="mx-auto flex max-w-7xl items-center justify-between rounded-full border border-blu/15 bg-cream/90 px-5 py-3 shadow-[0_10px_40px_rgba(13,46,111,.08)] backdrop-blur-xl" aria-label="Navegación principal">
        <a href="#inicio" class="flex items-center gap-3" aria-label="Blu, ir al inicio">
          <span class="grid size-10 place-items-center rounded-full bg-strawberry font-display text-lg font-black text-blu">blu</span>
          <span class="hidden text-xs font-bold uppercase tracking-[.18em] text-blu-dark sm:block">il gelato del barrio</span>
        </a>
        <div class="hidden items-center gap-8 text-sm font-bold md:flex">
          <a class="transition hover:text-blu" href="#sabores">Sabores</a>
          <a class="transition hover:text-blu" href="#historia">Nuestra forma</a>
          <a class="transition hover:text-blu" href="#locales">Locales</a>
        </div>
        <a href={whatsappUrl} target="_blank" rel="noreferrer" class="rounded-full bg-blu px-5 py-2.5 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-blu-dark">Pide tu Blu</a>
      </nav>
    </header>

    <main id="inicio">
      <section class="grain relative min-h-[760px] overflow-hidden bg-strawberry pt-28 md:min-h-screen md:pt-36">
        <div class="absolute -left-16 top-36 size-48 rounded-full border-[34px] border-cream/25 md:size-72"></div>
        <div class="absolute -right-16 bottom-20 size-56 rounded-full bg-pistachio md:size-80"></div>
        <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-10 px-5 pb-16 md:grid-cols-[1.05fr_.95fr] md:px-8">
          <div class="pt-8 md:pt-0">
            <p class="mb-6 inline-flex rotate-[-2deg] rounded-full bg-cream px-5 py-2 text-xs font-black uppercase tracking-[.2em] text-blu">{hero.eyebrow}</p>
            <h1 class="max-w-3xl font-display text-[clamp(4.8rem,12vw,10.5rem)] font-black leading-[.72] tracking-[-.085em] text-blu">
              {hero.wordmark}<span class="text-cream">!</span>
            </h1>
            <p class="mt-8 max-w-lg text-xl font-semibold leading-snug text-blu-dark md:text-2xl">{hero.intro}</p>
            <div class="mt-9 flex flex-wrap items-center gap-4">
              <a href="#sabores" class="rounded-full bg-blu px-7 py-4 font-extrabold text-white transition hover:-translate-y-1 hover:shadow-xl">{hero.primaryCta}</a>
              <a href="#locales" class="rounded-full border-2 border-blu px-7 py-4 font-extrabold text-blu transition hover:bg-blu hover:text-white">{hero.secondaryCta}</a>
            </div>
          </div>

          <div class="relative mx-auto w-full max-w-[570px]">
            <div class="aspect-[4/5] rotate-[3deg] overflow-hidden rounded-[3rem] border-[10px] border-cream shadow-[0_28px_80px_rgba(13,46,111,.28)]">
              <CloudinaryImage
                publicId={hero.imagePublicId}
                fallback={hero.imageUrl}
                alt={hero.imageAlt}
                width={900}
                height={1125}
                class="h-full w-full object-cover"
                priority
              />
            </div>
            <div class="absolute -bottom-7 -left-5 grid size-32 -rotate-12 place-items-center rounded-full bg-cream text-center shadow-xl md:-left-14 md:size-40">
              <span class="font-display text-2xl font-black leading-none text-blu md:text-3xl">fatto<br/>ogni<br/>giorno</span>
            </div>
          </div>
        </div>
      </section>

      <div class="overflow-hidden border-y-4 border-blu bg-blu py-4 text-cream" aria-hidden="true">
        <div class="marquee-track flex gap-8 font-display text-xl font-black uppercase tracking-wider md:text-2xl">
          <span>Pistacchio ✦ Lúcuma ✦ Stracciatella ✦ Maracumango ✦ Menta + muña ✦ Cioccolato ✦ </span>
          <span>Pistacchio ✦ Lúcuma ✦ Stracciatella ✦ Maracumango ✦ Menta + muña ✦ Cioccolato ✦ </span>
        </div>
      </div>

      <section id="sabores" class="bg-cream px-5 py-24 md:px-8 md:py-32">
        <div class="mx-auto max-w-7xl">
          <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
            <div>
              <p class="text-sm font-black uppercase tracking-[.22em] text-strawberry">{flavorsSection.eyebrow}</p>
              <h2 class="mt-3 max-w-3xl font-display text-5xl font-black leading-[.9] tracking-[-.055em] text-blu md:text-8xl">{flavorsSection.title}</h2>
            </div>
            <div class="flex gap-2" aria-label="Filtrar sabores">
              <button data-filter="all" class="filter-button rounded-full bg-blu px-5 py-2.5 text-sm font-black text-white">Todos</button>
              <button data-filter="gelato" class="filter-button rounded-full border-2 border-blu px-5 py-2.5 text-sm font-black text-blu">Gelati</button>
              <button data-filter="sorbetto" class="filter-button rounded-full border-2 border-blu px-5 py-2.5 text-sm font-black text-blu">Sorbetti</button>
            </div>
          </div>

          <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {flavors.map((flavor, index) => (
              <article data-flavor={flavor.category} class="flavor-card reveal group relative min-h-64 overflow-hidden rounded-[2rem] border-2 border-blu/15 p-7 transition duration-300 hover:-translate-y-2" style={`background:${flavor.color}; transition-delay:${index * 60}ms`}>
                <span class="text-xs font-black uppercase tracking-[.18em] text-blu-dark/60">0{index + 1} · {flavor.category}</span>
                <h3 class="mt-10 max-w-[80%] font-display text-4xl font-black leading-none tracking-[-.04em] text-blu-dark">{flavor.name}</h3>
                <p class="mt-3 font-semibold text-blu-dark/70">{flavor.note}</p>
                <span class="absolute -bottom-8 -right-5 size-32 rounded-[48%_52%_46%_54%] bg-cream/55 transition duration-500 group-hover:rotate-45 group-hover:scale-125"></span>
              </article>
            ))}
          </div>
          <p class="mt-6 text-sm font-semibold text-blu-dark/60">{flavorsSection.disclaimer}</p>
        </div>
      </section>

      <section id="historia" class="grain overflow-hidden bg-blu py-24 text-cream md:py-32">
        <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 md:grid-cols-2 md:px-8">
          <div class="reveal relative">
            <div class="aspect-square overflow-hidden rounded-[50%_50%_46%_54%] border-8 border-cream/90">
              <CloudinaryImage
                publicId={story.imagePublicId}
                fallback={story.imageUrl}
                alt={story.imageAlt}
                width={900}
                height={900}
                class="h-full w-full object-cover"
              />
            </div>
            <span class="absolute right-0 top-2 rounded-full bg-strawberry px-5 py-3 font-display text-lg font-black text-blu md:right-4">{story.foundingLabel}</span>
          </div>
          <div class="reveal">
            <p class="text-sm font-black uppercase tracking-[.22em] text-pistachio">{story.eyebrow}</p>
            <h2 class="mt-4 font-display text-5xl font-black leading-[.92] tracking-[-.05em] md:text-7xl">{story.title}<br/>{story.titleLine2}</h2>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-cream/80 md:text-xl">{story.description}</p>
            <div class="mt-10 grid grid-cols-3 gap-3 border-t border-cream/30 pt-7 text-center">
              {story.stats.map((stat) => (
                <div><strong class="block font-display text-3xl md:text-5xl" style={`color:${stat.color}`}>{stat.value}</strong><span class="text-xs font-bold uppercase tracking-wider text-cream/65">{stat.label}</span></div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="bg-[#f3b9ca] px-5 py-24 md:px-8 md:py-32">
        <div class="reveal mx-auto grid max-w-7xl overflow-hidden rounded-[2.5rem] bg-cream shadow-[0_24px_80px_rgba(13,46,111,.13)] md:grid-cols-[.9fr_1.1fr]">
          <div class="p-9 md:p-14">
            <p class="text-sm font-black uppercase tracking-[.22em] text-strawberry">{meeting.eyebrow}</p>
            <h2 class="mt-4 font-display text-5xl font-black leading-[.9] tracking-[-.05em] text-blu md:text-7xl">{meeting.title}</h2>
            <p class="mt-6 text-lg leading-relaxed text-blu-dark/75">{meeting.description}</p>
            <a href={links.instagram} target="_blank" rel="noreferrer" class="mt-8 inline-flex items-center gap-2 font-black text-blu underline decoration-2 underline-offset-4">{meeting.linkLabel}</a>
          </div>
          <div class="min-h-96 overflow-hidden">
            <CloudinaryImage
              publicId={meeting.imagePublicId}
              fallback={meeting.imageUrl}
              alt={meeting.imageAlt}
              width={1100}
              height={800}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </section>

      <section id="locales" class="bg-cream px-5 py-24 md:px-8 md:py-32">
        <div class="mx-auto max-w-7xl">
          <div class="reveal text-center">
            <p class="text-sm font-black uppercase tracking-[.22em] text-strawberry">Tu Blu más cercano</p>
            <h2 class="mt-3 font-display text-5xl font-black tracking-[-.05em] text-blu md:text-8xl">Nos vemos en el barrio.</h2>
          </div>
          <div class="mt-14 grid gap-4 md:grid-cols-2">
            {locations.map((location) => (
              <article class:list={['reveal rounded-[2rem] border-2 p-7 md:p-9', location.featured ? 'border-blu bg-blu text-white' : 'border-blu/15 bg-white text-blu-dark']}>
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <h3 class="font-display text-3xl font-black md:text-4xl">{location.district}</h3>
                    <p class:list={['mt-2 font-semibold', location.featured ? 'text-white/70' : 'text-blu-dark/60']}>{location.address}</p>
                  </div>
                  {location.featured && <span class="rounded-full bg-strawberry px-3 py-1 text-xs font-black uppercase tracking-wider text-blu">Casa madre</span>}
                </div>
                <div class:list={['mt-8 flex items-end justify-between border-t pt-5', location.featured ? 'border-white/25' : 'border-blu/15']}>
                  <div><span class="block text-xs font-black uppercase tracking-wider opacity-60">Todos los días</span><strong class="mt-1 block">{location.hours}</strong></div>
                  <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Blu ${location.address} ${location.district} Lima`)}`} target="_blank" rel="noreferrer" class="grid size-11 place-items-center rounded-full border-2 border-current text-xl transition hover:scale-110" aria-label={`Ver ${location.district} en el mapa`}>↗</a>
                </div>
              </article>
            ))}
          </div>
          <p class="mt-6 text-center text-sm font-semibold text-blu-dark/55">Horarios y direcciones sujetos a confirmación con la marca antes de publicar.</p>
        </div>
      </section>

      <section class="grain bg-pistachio px-5 py-24 text-center md:px-8 md:py-32">
        <div class="reveal relative z-10 mx-auto max-w-4xl">
          <span class="text-6xl" aria-hidden="true">🍨</span>
          <h2 class="mt-5 font-display text-5xl font-black leading-[.9] tracking-[-.055em] text-blu md:text-8xl">{finalCta.title}</h2>
          <p class="mx-auto mt-6 max-w-xl text-lg font-semibold text-blu-dark/70">{finalCta.description}</p>
          <a href={`${whatsappUrl}?text=${encodeURIComponent(finalCta.whatsappMessage)}`} target="_blank" rel="noreferrer" class="mt-9 inline-flex rounded-full bg-blu px-8 py-4 font-black text-white transition hover:-translate-y-1 hover:shadow-xl">{finalCta.buttonLabel}</a>
        </div>
      </section>
    </main>

    <footer class="bg-blu-dark px-5 py-10 text-cream md:px-8">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div><div class="font-display text-5xl font-black text-strawberry">blu!</div><p class="mt-2 text-sm text-cream/60">Gelato italiano, espíritu peruano.</p></div>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold">
          <a class="hover:text-strawberry" href={links.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
          <a class="hover:text-strawberry" href={links.orders} target="_blank" rel="noreferrer">Pedidos ↗</a>
          <span class="text-cream/45">Bosquejo inicial · 2026</span>
        </div>
      </div>
    </footer>

    <script>
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));

      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
      const cards = document.querySelectorAll<HTMLElement>('.flavor-card');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const selected = button.dataset.filter;
          buttons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('bg-blu', active);
            item.classList.toggle('text-white', active);
            item.classList.toggle('text-blu', !active);
          });
          cards.forEach((card) => {
            const visible = selected === 'all' || card.dataset.flavor === selected;
            card.hidden = !visible;
          });
        });
      });
    </script>
  </body>
</html>
